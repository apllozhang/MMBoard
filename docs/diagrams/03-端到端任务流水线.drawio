<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ZCode">
  <diagram id="flow03" name="端到端任务流水线">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="1900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="u1" value="上传 POST /api/tasks(multipart,单文件 ≤2GB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="四道防线:CL&gt;2GB→413;磁盘&lt;1GB→503;配额(占用+预留+本次)→503;媒体探测无音轨→400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="360" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="落盘 uploads/{uuid} → createTask(高水位编号,dirKey=uuid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="q1" value="入串行队列(容量 10,满→503)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="350" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ex" value="extract:ffmpeg → 16kHz 单声道 mp3(无 ffmpeg 跳过)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="450" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="r_route" value="asr.provider?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="470" y="550" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="flyC" value="讯飞通道(耗额度)" style="swimlane;startSize=30;html=1;fillColor=none;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="700" width="380" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="fly1" value="assertQuotaReady(记账可读可写,双坏→任务失败)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="flyC">
          <mxGeometry x="20" y="45" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="fly2" value="签名 → 分片上传 → merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="flyC">
          <mxGeometry x="20" y="90" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="fly3" value="轮询(瞬态≤5 次指数退避;业务码立即失败)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="flyC">
          <mxGeometry x="20" y="135" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="fly4" value="记账 recordQuota(失败→quotaRecordFailed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="flyC">
          <mxGeometry x="20" y="180" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="locC" value="本地 FunASR(免费)" style="swimlane;startSize=30;html=1;fillColor=none;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="700" width="380" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="loc1" value="guardedFetch:/health → 提交 → 轮询(连续 3 次失败判负)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="locC">
          <mxGeometry x="20" y="45" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="loc2" value="工作机 worker 转码/识别(不阻塞主服务)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="locC">
          <mxGeometry x="20" y="90" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="loc3" value="结果与临时文件 TTL 清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="locC">
          <mxGeometry x="20" y="135" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="chk" value="转写结果校验(&lt;10 字 → 失败)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="900" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a_route" value="&gt;42000 字?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="470" y="1000" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="chunkC" value="分块 map/reduce" style="swimlane;startSize=30;html=1;fillColor=none;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="1130" width="380" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="ck1" value="splitChunks(行边界,30000 字/块)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="chunkC">
          <mxGeometry x="20" y="45" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="ck2" value="map 逐块(prompt 含本块原文;瞬态重试 1 次)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="chunkC">
          <mxGeometry x="20" y="90" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="ck3" value="失败块 → chunkFailures + 占位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="chunkC">
