        </mxCell>
        <mxCell id="sg1" value="analyzeOnce(失败 3s 后重试一次)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="singleC">
          <mxGeometry x="20" y="45" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="sg2" value="4xx noRetry 立即失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="singleC">
          <mxGeometry x="20" y="90" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="sg3" value="空正文 → 明确报错(防思考预算耗尽被当成功)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="singleC">
          <mxGeometry x="20" y="135" width="330" height="36" as="geometry"/>
