        <mxCell id="ck4" value="reduce:头 6000 + 块摘要 + 尾 4000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="chunkC">
          <mxGeometry x="20" y="180" width="330" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="ck5" value="chunkFailures 非空 → 强制 partial=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="chunkC">
          <mxGeometry x="20" y="225" width="330" height="36" as="geometry"/>
