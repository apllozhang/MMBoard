        <mxCell id="r2" value="任意次改名 → 纯重渲染即时生效;&lt;br&gt;行动项 owner/图表/统计同步替换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
