<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="ZCode">
  <diagram id="data11" name="数据文件关系图">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" page="1" pageWidth="1020" pageHeight="680">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="tasks" value="tasks.json&lt;br&gt;id/uuid(dirKey)/runId/stage/&lt;br&gt;speakerMap/quotaRecordFailed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="390" y="230" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="uploads" value="uploads/&lt;br&gt;{uuid}.ext(源文件)&lt;br&gt;{uuid}.mp3(16kHz 转码)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;size=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="outputs" value="outputs/{dirKey}/&lt;br&gt;transcript.json / analysis.json / *.html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="settings" value="settings.json&lt;br&gt;version/activeId/models/asr/&lt;br&gt;allowedLlmHosts/iflytek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d8;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="auth.json&lt;br&gt;bcrypt 口令/初始化标记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d8;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="quota" value="quota.json&lt;br&gt;{本地日期: 转写秒数}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d8;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="seq" value="seq-highwater.json&lt;br&gt;{UTC日期段: 最大序号}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d8;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="470" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="全部 *.json 经 persist.cjs 原子写(临时文件+rename,主备 .bak;主坏读备、损坏隔离 .corrupt、双坏 fail-closed)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="920" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="存储键关联(删除连带清理)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="tasks" target="uploads">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="dirKey=uuid(旧数据回退编号)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="tasks" target="outputs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="仅重跑分析复用 transcript(不耗额度)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="outputs" target="tasks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="记账(讯飞真实转写)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="tasks" target="quota">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="createTask 高水位" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="tasks" target="seq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="loadSecret:激活模型/通道/白名单生效" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="settings" target="tasks">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
